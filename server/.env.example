PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/codedemonss
CORS_ORIGIN=*

# JWT Authentication
ACCESS_TOKEN_SECRET=super_secret_access_jwt_key_change_in_production
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_change_in_production

# Mail (Brevo)
BREVO_API_KEY=
SENDING_USER="codedemons <codedemons.in@gmail.com>"
SEND_MAIL=false
# Inbox that receives contact form inquiries
CONTACT_EMAIL=hello@codedemons.in

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Admin panel login (use a long random password)
ADMIN_EMAIL=admin@codedemons.in
ADMIN_PASSWORD=change_me_to_a_long_random_password

# ImageKit media storage (dashboard > Developer options). Required: every upload (images, videos, logos) goes here.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/codedemons

# Website licenses: long random string, keep it forever (changing it breaks every live license)
LICENSE_SECRET=

# Payments. UPI_ID alone = clients pay by UPI QR and you confirm.
# Add Razorpay keys to detect payments automatically (UPI, cards, netbanking).
UPI_ID=
UPI_NAME=codedemons
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
